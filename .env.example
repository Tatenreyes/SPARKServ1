# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key — NEVER expose this with NEXT_PUBLIC_. Used only in API routes
# that need to bypass RLS (e.g. admin approving technicians).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser push notifications (Web Push / VAPID). NEXT_PUBLIC_VAPID_PUBLIC_KEY
# is safe to expose to the browser; VAPID_PRIVATE_KEY must stay server-only.
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Semaphore SMS (https://api.semaphore.co/api/v4/messages). Server-only — never
# prefix with NEXT_PUBLIC_. SENDER_NAME is optional and defaults to the account's
# registered sender name. Used by /api/admin/sms-test and src/lib/sms.ts.
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=YourSenderName

# Protects /api/cron/assignment-tick, which lapses expired job offers and
# re-matches requests that were previously "waiting". Vercel Cron sends this
# as `Authorization: Bearer <CRON_SECRET>` automatically once it's set here.
# Generate any long random string, e.g.: openssl rand -hex 32
CRON_SECRET=your-long-random-secret
